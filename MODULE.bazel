bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.8.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "ch.qos.logback:logback-classic:1.5.22",
        "com.google.auto.value:auto-value-annotations:1.11.1",
        "com.google.auto.value:auto-value:1.11.1",
        "com.google.code.gson:gson:2.13.2",
        "com.google.guava:guava:33.5.0-jre",
        "com.google.truth:truth:1.4.5",
        "net.java.dev.jna:jna:5.18.1",
        "org.bytedeco:ffmpeg:jar:macosx-arm64:8.1.2-1.5.14",
        "org.bytedeco:javacpp:jar:macosx-arm64:1.5.14",
        "org.junit.jupiter:junit-jupiter-api:6.0.2",
        "org.junit.jupiter:junit-jupiter-engine:6.0.2",
        "org.junit.jupiter:junit-jupiter-params:6.0.2",
        "org.junit.platform:junit-platform-launcher:6.0.2",
        "org.junit.platform:junit-platform-reporting:6.0.2",
        "org.mockito:mockito-core:5.23.0",
        "org.mockito:mockito-junit-jupiter:5.23.0",
        "org.slf4j:slf4j-api:2.0.17",
    ],
    fetch_sources = True,
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)

# Only FFmpegFrameRecorder is used, so leave out JavaCV's other native libraries.
maven.artifact(
    artifact = "javacv",
    exclusions = [
        "org.bytedeco:artoolkitplus",
        "org.bytedeco:flandmark",
        "org.bytedeco:flycapture",
        "org.bytedeco:leptonica",
        "org.bytedeco:libdc1394",
        "org.bytedeco:libfreenect",
        "org.bytedeco:libfreenect2",
        "org.bytedeco:librealsense",
        "org.bytedeco:librealsense2",
        "org.bytedeco:openblas",
        "org.bytedeco:opencv",
        "org.bytedeco:tesseract",
        "org.bytedeco:videoinput",
    ],
    group = "org.bytedeco",
    version = "1.5.14",
)
use_repo(maven, "maven")
